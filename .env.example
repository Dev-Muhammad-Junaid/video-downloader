# Optional environment overrides for SnapDown's secrets.
#
# You normally don't need this file. On macOS, SnapDown stores API keys and R2
# credentials in your login Keychain, and migrates any it finds in the old
# plaintext settings file automatically on first run.
#
# These variables exist for the case where you'd rather a secret never reach
# any persistent store at all — inject it from your shell profile or a password
# manager instead:
#
#   export SNAPDOWN_GROQ_API_KEY="$(op read 'op://Private/Groq/credential')"
#
# An environment value takes precedence over the Keychain, and SnapDown will
# refuse to persist it, so it can't leak back into storage.
#
# NOTE: a .env file is itself plaintext on disk — it keeps secrets out of the
# Keychain and the settings file, but it is not encryption. .env* is gitignored.

# Transcription
SNAPDOWN_OPENAI_API_KEY=
SNAPDOWN_GROQ_API_KEY=

# Cloudflare R2 / S3-compatible cloud sync
SNAPDOWN_R2_ENDPOINT=
SNAPDOWN_R2_BUCKET=
SNAPDOWN_R2_REGION=
SNAPDOWN_R2_ACCESS_KEY=
SNAPDOWN_R2_SECRET_KEY=
