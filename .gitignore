# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local data
/dev.db
/dev.db.bak*
/downloads
/download_destination
thumbnails/
ytdlp_test.json

# server settings (contains API keys — never commit)
.server_settings.json

# Claude Code sessions and transcripts
.claude/
transcripts/

# JASSUB build output — regenerated by `npm run prebuild:jassub`
/public/jassub/
