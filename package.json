{
  "name": "snapdown",
  "version": "0.3.5",
  "description": "A local-first media studio: download, organize, edit, transcribe, and cloud-back-up video/image/audio from social platforms.",
  "author": "Muhammad Junaid <https://github.com/Dev-Muhammad-Junaid>",
  "license": "MIT",
  "homepage": "https://github.com/Dev-Muhammad-Junaid/video-downloader",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dev-Muhammad-Junaid/video-downloader.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "prebuild:jassub": "node -e \"const fs=require('fs');fs.mkdirSync('public/jassub',{recursive:true});if(!fs.existsSync('public/jassub/jassub.js')){const {execSync}=require('child_process');execSync('npx esbuild node_modules/jassub/dist/jassub.js --bundle --format=esm --platform=browser --outfile=public/jassub/jassub.js',{stdio:'inherit'})};['jassub-worker.js','jassub-worker.wasm','jassub-worker-modern.wasm','default.woff2'].forEach(f=>{const src='node_modules/jassub/dist/'+(f.endsWith('.wasm')||f==='jassub-worker.js'?'wasm/':'')+f,dst='public/jassub/'+f;if(!fs.existsSync(dst))fs.copyFileSync(src,dst)})\"",
    "dev": "npm run prebuild:jassub && next dev",
    "build": "npm run prebuild:jassub && next build",
    "postbuild": "node scripts/copy-standalone-assets.cjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tests/smoke.mjs",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c blue,magenta \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && npm run rebuild:electron && node scripts/sync-electron-sqlite-binary.cjs && node scripts/finalize-standalone.cjs && electron-builder --mac",
    "postelectron:build": "npm run rebuild:node",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "build:icon": "node scripts/build-icon.cjs"
  },
  "build": {
    "appId": "com.snapdown.app",
    "productName": "SnapDown",
    "npmRebuild": false,
    "files": [
      "!**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone-wrapped",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        "dmg",
        "dir"
      ]
    },
    "dmg": {
      "title": "SnapDown ${version}"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/lib-storage": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "jassub": "^2.5.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "openai": "^6.29.0",
    "p-limit": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.33.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "shadcn": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}
