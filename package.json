{
  "name": "snapdown",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild:jassub": "node -e \"const fs=require('fs');fs.mkdirSync('public/jassub',{recursive:true});if(!fs.existsSync('public/jassub/jassub.js')){const {execSync}=require('child_process');execSync('npx esbuild node_modules/jassub/dist/jassub.js --bundle --format=esm --platform=browser --outfile=public/jassub/jassub.js',{stdio:'inherit'})};['jassub-worker.js','jassub-worker.wasm','jassub-worker-modern.wasm','default.woff2'].forEach(f=>{const src='node_modules/jassub/dist/'+(f.endsWith('.wasm')||f==='jassub-worker.js'?'wasm/':'')+f,dst='public/jassub/'+f;if(!fs.existsSync(dst))fs.copyFileSync(src,dst)})\"",
    "dev": "npm run prebuild:jassub && next dev",
    "build": "npm run prebuild:jassub && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/lib-storage": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "jassub": "^2.5.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "openai": "^6.29.0",
    "p-limit": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.33.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "shadcn": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
