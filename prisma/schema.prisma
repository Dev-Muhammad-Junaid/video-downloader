// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Video {
  id                String   @id @default(uuid())
  title             String
  duration          Float?
  originalUrl       String?
  sourcePlatform    String?
  localPath         String
  fileSize          Int?
  mediaType         String   @default("video") // "video" or "image"
  previewUrl        String?
  sourceId          String?  // The ID from the platform (e.g. tweet ID or youtube ID)
  thumbnailPath     String?  // Path to auto-generated thumbnail
  cloudKey          String?  // S3 object key (e.g. "uploads/123_video.mp4")
  cloudUrl          String?  // Full URL to the cloud-stored file
  cloudUploadedAt   DateTime? // When the file was uploaded to R2

  // Transcription (WID-307)
  transcriptText    String?  // Full plain-text transcript for deep search (WID-308)
  transcriptPath    String?  // Path to the .vtt subtitle file on disk
  transcriptStatus  String?  // "pending" | "processing" | "completed" | "error"

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  labels            Label[]  // Implicit m-to-n relation
}

model Label {
  id            String   @id @default(uuid())
  name          String   @unique
  color         String?  // Optional hex or color literal
  autoCloudSync Boolean  @default(false) // WID-306
  
  videos    Video[]  // Implicit m-to-n relation
  
  createdAt DateTime @default(now())
}

model DownloadProfile {
  id              String   @id @default(uuid())
  name            String   @unique
  sitePattern     String?  // e.g. "youtube.com", "twitter.com", "*"
  
  maxResolution        String?  @default("best") // "720p", "1080p", "1440p", "2160p", "best"
  preferredFormat      String?  @default("mp4")  // "mp4", "mkv", "webm", "mp3"
  preferredImageFormat String?  @default("original") // "original", "jpg", "png", "webp"

  autoCloudSync   Boolean  @default(false)
  requireManualFormat Boolean @default(false)
  strictResolution Boolean @default(false) // if true, require EXACT match on maxResolution (e.g. "4K Only" means only 2160p)
  
  isActive        Boolean  @default(true)
  priority        Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DownloadLog {
  id             String    @id @default(uuid())
  url            String
  title          String
  sourcePlatform String?
  status         String    // "downloading" | "completed" | "error" | "processing"
  errorMessage   String?
  fileSize       Int?
  videoId        String?   // Link to Video if successful
  duration       Float?    // Download/transcription duration in seconds
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  // Transcription tracking (WID-307)
  type           String    @default("download")  // "download" | "transcription"
  output         String?   // Transcript snippet (first 500 chars) or error output
}

model DownloadQueueJob {
  id               String   @id
  url              String
  title            String
  sourcePlatform   String?
  mediaType        String   @default("video")
  imageUrl         String?
  thumbnailUrl     String?
  duration         Float?
  formatId         String?
  formatLabel      String?
  profileName      String?
  qualityPreset    String?
  duplicatePolicy  String   @default("keep-both") // "skip" | "replace" | "keep-both"
  status           String   // "pending" | "queued" | "downloading" | "processing" | "paused" | "completed" | "error" | "cancelled"
  progress         Float    @default(0)
  position         Int      @default(0)
  downloadPath     String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?
}
