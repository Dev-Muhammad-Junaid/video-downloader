// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Video {
  id                String   @id @default(uuid())
  title             String
  duration          Float?
  originalUrl       String?
  sourcePlatform    String?
  localPath         String
  fileSize          Int?
  mediaType         String   @default("video") // "video" or "image"
  previewUrl        String?
  sourceId          String?  // The ID from the platform (e.g. tweet ID or youtube ID)
  thumbnailPath     String?  // Path to auto-generated thumbnail
  cloudKey          String?  // S3 object key (e.g. "uploads/123_video.mp4")
  cloudUrl          String?  // Full URL to the cloud-stored file
  cloudUploadedAt   DateTime? // When the file was uploaded to R2

  // Transcription (WID-307)
  transcriptText    String?  // Full plain-text transcript for deep search (WID-308)
  transcriptPath    String?  // Path to the .vtt subtitle file on disk
  transcriptStatus  String?  // "pending" | "processing" | "completed" | "error"

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  labels            Label[]  // Implicit m-to-n relation
}

model Label {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?  // Optional hex or color literal
  
  videos    Video[]  // Implicit m-to-n relation
  
  createdAt DateTime @default(now())
}

model DownloadLog {
  id             String    @id @default(uuid())
  url            String
  title          String
  sourcePlatform String?
  status         String    // "downloading" | "completed" | "error" | "processing"
  errorMessage   String?
  fileSize       Int?
  videoId        String?   // Link to Video if successful
  duration       Float?    // Download/transcription duration in seconds
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  // Transcription tracking (WID-307)
  type           String    @default("download")  // "download" | "transcription"
  output         String?   // Transcript snippet (first 500 chars) or error output
}
